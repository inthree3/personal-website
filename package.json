{
  "name": "stella-personal-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "python3 -m http.server 4173 --directory dist",
    "deploy": "npm run build && npx wrangler@4.152.0 pages deploy dist --project-name stella-hwang-personal --branch main && node scripts/newsletter.mjs",
    "newsletter": "node scripts/newsletter.mjs",
    "dev": "node scripts/dev.mjs",
    "test:editor": "node --test tests/editor.browser.mjs",
    "resume": "node scripts/resume.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
